# Application
LOG_LEVEL=INFO
OLLAMA_BASE_URL=http://localhost:11434
GENERATION_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# These use GENERATION_MODEL when omitted.
# TOOL_CALLING_MODEL=llama3.2:3b
# QUERY_REWRITING_MODEL=llama3.2:3b

SERVER_HOST=127.0.0.1
SERVER_PORT=8000

DOCUMENTS_DIR=./knowledge-base
DATA_DIR=./data
WEB_DIR=./web

# Derived from DATA_DIR when omitted.
# CHROMA_DB_DIR=./data/rag_data
# ROUTER_STORE_DIR=./data/router_data

# Optional external overrides. Packaged defaults are used when omitted.
# MASTER_PROMPT_FILE=./config/master_prompt.json
# TOOL_CALLING_CONFIG_FILE=./config/tool_calling.json
# ROUTING_DIR=./config/routing

# Indexing and generation
AUTO_INDEX_ON_STARTUP=true
CHUNK_SIZE=500
CHUNK_OVERLAP=100
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35
GENERATION_TEMPERATURE=0.7

# Optional features
TOOL_CALLING_ENABLED=true
TOOL_CALLING_MAX_ROUNDS=2

CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_MAX_MESSAGES=8
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_SESSIONS=1000
CONVERSATION_MAX_MESSAGE_CHARS=2000

QUERY_REWRITING_ENABLED=true
QUERY_REWRITING_USE_LLM=true
RERANKING_MODE=auto
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_ALLOW_LEXICAL_FALLBACK=false

# Runtime controls
MAX_INPUT_CHARS=1000
REPLY_TIMEOUT_SECONDS=60

OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_READ_TIMEOUT_SECONDS=60
OLLAMA_MAX_RESPONSE_BYTES=4194304

MAX_CONCURRENT_INFERENCES=2
MAX_PENDING_INFERENCES=4

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_BUCKETS=10000

# Document ingestion limits
MAX_DOCUMENT_FILE_SIZE_BYTES=26214400
MAX_ZIP_ENTRIES=1000
MAX_ZIP_UNCOMPRESSED_BYTES=104857600
MAX_ZIP_COMPRESSION_RATIO=100
MAX_PDF_PAGES=1000
MAX_SPREADSHEET_SHEETS=100
MAX_SPREADSHEET_ROWS=100000
MAX_PRESENTATION_SLIDES=500

# Advanced retrieval tuning
# Keep these commented unless retrieval behavior is being measured.
# HYBRID_DENSE_K=10
# HYBRID_DENSE_FETCH_K=20
# HYBRID_SPARSE_K=10
# HYBRID_CANDIDATE_K=10
# HYBRID_FINAL_K=5
# HYBRID_DENSE_LAMBDA_MULT=0.5
# HYBRID_DENSE_WEIGHT=0.5
# HYBRID_SPARSE_WEIGHT=0.5
# METADATA_BOOST_WEIGHT=0.10

# Input normalization
# Keep defaults unless the knowledge base requires different behavior.

# CLEANER_REMOVE_EMOJIS=true
# CLEANER_EXPAND_ABBREVIATIONS=true
# CLEANER_NORMALIZE_UNICODE=true
# CLEANER_REMOVE_EXTRA_SPACES=true
# CLEANER_LOWERCASE=true

